# Supabase — service role key from:
# https://supabase.com/dashboard/project/mgpttvwkkcgzbmwzupdo/settings/api
SUPABASE_URL=https://mgpttvwkkcgzbmwzupdo.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service_role_secret_from_supabase_dashboard>

# Resend — https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxx
# Use onboarding@resend.dev for testing; swap for a verified domain in prod
RESEND_FROM_EMAIL=onboarding@resend.dev

# App base URL — no trailing slash
NEXT_PUBLIC_BASE_URL=https://bedrock-digest.vercel.app

# Email encryption key — generate with: openssl rand -hex 32
EMAIL_ENCRYPTION_KEY=<64_char_hex_string>

# HMAC secret for email deduplication — generate with: openssl rand -hex 32
EMAIL_HMAC_SECRET=<any_long_random_string>

# Anon/public key (used as fallback when service_role key is absent in dev)
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# CEO / admin email — used by the test-send endpoint fallback
CEO_EMAIL=franco@falaschi.com

# Bearer token that gates the /api/email/* endpoints — generate with: openssl rand -hex 32
DIGEST_SEND_SECRET=your-secret-here

# Bearer token that gates the /api/ingest cron endpoint — generate with: openssl rand -hex 32
CRON_SECRET=your-cron-secret-here
