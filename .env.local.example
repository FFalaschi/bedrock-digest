# ── Resend ──────────────────────────────────────────────────────────────────
# Get your API key at https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxx

# The verified sending address (domain must be added + DKIM configured in Resend dashboard)
RESEND_FROM_ADDRESS=digest@bedrock.email

# Unsubscribe mailto address (same domain as RESEND_FROM_ADDRESS)
RESEND_UNSUBSCRIBE_EMAIL=unsubscribe@bedrock.email

# ── App ──────────────────────────────────────────────────────────────────────
# Public base URL (used for unsubscribe links and other absolute URLs)
NEXT_PUBLIC_BASE_URL=https://bedrock.email

# CEO / admin email — used by the test-send endpoint fallback
CEO_EMAIL=franco@falaschi.com

# ── Security ─────────────────────────────────────────────────────────────────
# Bearer token that gates the /api/email/* endpoints. Generate with:
#   openssl rand -hex 32
DIGEST_SEND_SECRET=your-secret-here
